# Copy to .env and edit. Never commit .env — it is git-ignored.

# Required on the very first run: it creates the owner login.
# Minimum 12 characters. Change it after signing in.
LEDGER_OWNER_PASSWORD=choose-a-long-password

# Optional: the owner's username (default: owner)
# LEDGER_OWNER_USER=owner

# Fill an empty ledger with sample data so you can look around before
# entering anything real. Set to 0 (or remove) for a clean start.
# LEDGER_DEMO_SEED=1

# Which address the container's port is published on.
#   127.0.0.1  → this computer only (default, safest)
#   0.0.0.0    → any device on your network, INCLUDING the café Wi-Fi
# To use Ledger from a phone, a private network such as Tailscale is safer
# than 0.0.0.0, because it encrypts the connection.
# LEDGER_BIND=127.0.0.1
# LEDGER_PORT=8080

# TZ=Asia/Kolkata
